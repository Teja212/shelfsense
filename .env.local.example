# Copy to .env.local and fill in. NEVER commit the real key.
QLOO_API_KEY=your-hackathon-key-here
# Optional override (defaults to the hackathon host):
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# DeepSeek — optional. Enables the agent to act on free-text preferences
# ("shorter", "less dark") and to phrase grounded reasons. Without it, the
# agent falls back to deterministic behavior.
DEEPSEEK_API_KEY=your-deepseek-key-here
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Upstash Redis — needed only in production on serverless hosts (Vercel) so
# inventory edits and the A/B tally persist across invocations. Leave unset
# locally to use the in-memory store. Create a free DB at console.upstash.com.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token
